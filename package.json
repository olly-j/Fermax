{
  "name": "homebridge-fermax-blue",
  "version": "0.2.0-beta.2",
  "description": "Homebridge platform plugin that bridges Fermax Blue / DuoxMe doorbells into HomeKit with doorbell, lock, and video feed.",
  "main": "src/index.js",
  "type": "commonjs",
  "files": [
    "src",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "verify-install.js",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "jest --config jest.config.js",
    "setup": "node src/setup/cli.js",
    "lint": "eslint src __tests__ verify-install.js",
    "verify": "npm run lint && npm test -- --runInBand && node verify-install.js"
  },
  "keywords": [
    "homebridge-plugin",
    "fermax",
    "doorbell",
    "homekit",
    "duox"
  ],
  "author": "Oliver Jeffers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olly-j/Fermax.git"
  },
  "bugs": {
    "url": "https://github.com/olly-j/Fermax/issues"
  },
  "homepage": "https://github.com/olly-j/Fermax#readme",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0",
    "homebridge": ">=1.11.0 <3"
  },
  "homebridge": {
    "platforms": [
      {
        "platform": "FermaxBluePlatform",
        "plugin_map": {
          "plugin_name": "homebridge-fermax-blue"
        }
      }
    ]
  },
  "dependencies": {
    "@eneris/push-receiver": "4.4.0",
    "ffmpeg-for-homebridge": "2.2.2"
  },
  "peerDependencies": {
    "homebridge": ">=1.11.0 <3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "homebridge": "^2.4.0",
    "jest": "^29.7.0"
  },
  "bin": {
    "fermax-blue-setup": "src/setup/cli.js"
  }
}
